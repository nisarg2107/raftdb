    {
      "id": 19,
      "title": "Logical operation throughput (operations/sec)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(method) (rate(raftdb_operations_total[10s]))",
          "legendFormat": "{{method}}{{instance}} {{operation}}{{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 20,
      "title": "Committed operations per Raft command",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(raftdb_committed_batch_operations_sum[10s]) / clamp_min(rate(raftdb_committed_batch_operations_count[10s]), 0.000001)",
          "legendFormat": "{{method}}{{instance}} {{operation}}{{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
