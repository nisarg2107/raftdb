# Keep all normal Compose commands on the current deployment.
COMPOSE_PROJECT_NAME=raftdb-verify
RAFTDB_IMAGE=raftdb-verify:dev
# Tested Linux WAL configuration on this machine; CPU quotas are ceilings.
RAFTDB_STORAGE=wal
RAFTDB_CPUS=4.0
RAFTDB_GOMAXPROCS=4
# Selected by bounded write tests; see README.md.
RAFTDB_WRITE_PIPELINE=2
